{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch_small", // search for logos: fastfetch --list-logos or --print-logos
        "padding": {
	        "top": 1,
          "right": 5,
          "left": 2
	},
    },
    "display": {
        "separator": "  "
    },
    "modules": [
	"break",
	"title",

        {
            "type": "kernel",
            "key": "kernel",

        },
        "cpu",
        "gpu",
        {
            "type": "memory",
            "key": "memory",

        },
        "battery",
        "break",
    ]
}
